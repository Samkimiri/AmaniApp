{
  "expo": {
    "name": "Amani: Sermon Notes",
    "slug": "amani-app",
    "scheme": "amani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3A5F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amaniapp.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3A5F"
      },
      "package": "com.amaniapp.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Amani: Sermon Notes",
      "shortName": "Amani",
      "themeColor": "#1F3A5F",
      "backgroundColor": "#1F3A5F",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Amani uses your photos to attach a picture (like a sermon slide) to a note.",
          "cameraPermission": "Amani uses your camera to photograph a sermon slide or note to attach it."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Amani uses your microphone to record sermon audio alongside your notes."
        }
      ]
    ]
  }
}
